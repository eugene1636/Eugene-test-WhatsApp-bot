# --- WhatsApp Cloud API (via a Coexistence-capable provider: Wati, 360dialog, ...) ---
# Access token for the Cloud API (from Meta / the tech partner)
WHATSAPP_ACCESS_TOKEN=
# Phone number ID of the warmed-up MDS number
WHATSAPP_PHONE_NUMBER_ID=
# Token you choose; Meta echoes it back on webhook verification (GET)
WHATSAPP_VERIFY_TOKEN=change-me
# Meta app secret, used to validate X-Hub-Signature-256 on webhooks (optional but recommended)
WHATSAPP_APP_SECRET=
# Graph API version
WHATSAPP_API_VERSION=v20.0

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model per spec (section 2)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Airtable (existing MDS Member Database base) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Table names (override if the base uses different ones)
AIRTABLE_MEMBERS_TABLE=Members
AIRTABLE_CONVERSATION_LOG_TABLE=Conversation Log
AIRTABLE_PILOT_PICKS_TABLE=Pilot Picks

# --- Behaviour ---
# Debounce window: wait this long after an inbound message before replying,
# so a burst of texts gets one coherent reply (spec: 20s)
DEBOUNCE_SECONDS=20
# Agent stays silent on a thread if a human replied from the phone app
# within this window (spec: 4 hours)
HUMAN_PAUSE_HOURS=4
# How many recent Conversation Log rows to send to Claude (spec: ~30)
LOG_CONTEXT_ROWS=30
# Approved Meta template name for the weekly digest (Sprint 2)
DIGEST_TEMPLATE_NAME=olivia_weekly_digest
DIGEST_TEMPLATE_LANGUAGE=en

# --- Server ---
PORT=3000
