# Supabase = the KPI warehouse.
# Project settings -> Database -> Connection string -> URI. Use the pooler URI
# for scheduled runs. Keep sslmode=require on it.
SUPABASE_DB_URL=

# Airtable is still the member system of record (ScoreCard base), a *source* for
# the phase 3 activation and engagement metrics. It is no longer the warehouse.
AIRTABLE_API_KEY=
AIRTABLE_SCORECARD_BASE_ID=

# Stripe (restricted key, read-only)
STRIPE_API_KEY=

# GoHighLevel
GHL_API_KEY=
GHL_LOCATION_ID=
# Which calendars count as discovery calls. Set the ids, or leave them blank and
# every calendar whose name contains GHL_DISCOVERY_CALENDAR_MATCH is used.
GHL_DISCOVERY_CALENDAR_IDS=
GHL_DISCOVERY_CALENDAR_MATCH=discovery
# Version header. Current GHL docs say v3; older tokens want a date
# (2021-04-15 for calendars, 2021-07-28 for contacts).
GHL_API_VERSION=v3
# Contact lookup: post = POST /contacts/search (current), get = GET /contacts/ (older).
GHL_CONTACT_SEARCH=post
# Run: python scripts/preflight.py --only gohighlevel
# It probes both of the above against your token and prints what to set.

# Luma
LUMA_API_KEY=

# ClickUp
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=2264119

# Hootsuite
HOOTSUITE_CLIENT_ID=
HOOTSUITE_CLIENT_SECRET=

# Intercom
INTERCOM_ACCESS_TOKEN=

# Anthropic (recap generation)
ANTHROPIC_API_KEY=
RECAP_MODEL=claude-opus-5

# Delivery. One channel per audience: SLACK_RECAP_CHANNEL_<DEPARTMENT>.
# Anything with no channel set is skipped and reported, never silently dropped.
SLACK_BOT_TOKEN=
SLACK_RECAP_CHANNEL_EXEC=
SLACK_RECAP_CHANNEL_GROWTH=
# SLACK_RECAP_CHANNEL_RETENTION=
# SLACK_RECAP_CHANNEL_COMMUNITY=
# SLACK_RECAP_CHANNEL_EVENTS=
# SLACK_RECAP_CHANNEL_MARKETING=
# SLACK_RECAP_CHANNEL_OPS=
# WhatsApp delivery reuses existing n8n webhook
N8N_WHATSAPP_WEBHOOK_URL=

TIMEZONE=America/New_York
